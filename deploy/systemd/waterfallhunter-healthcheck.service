[Unit]
Description=WaterfallHunter bounded health recovery check
After=waterfallhunter.service docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
# Keep the recovery scope narrow: one unhealthy container at a time, never a
# compose rebuild or stack-wide restart from a once-per-minute timer.
ExecStart=/usr/bin/python3 /srv/waterfallhunter/app/scripts/healthcheck_simple.py
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
